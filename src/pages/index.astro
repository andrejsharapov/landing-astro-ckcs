---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutCavaliers from '../components/AboutCavaliers.astro';
import Process from '../components/Process.astro';
import Catalog from '../components/Catalog.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Order from '../components/Order.astro';
import Footer from '../components/Footer.astro';
import data from '../data/landing.json';

const { meta, hero, about, features, process, figures, testimonials, faq, legal } = data;
---

<Layout title={meta.title} description={meta.description}>
  <Header brand={meta.brand} />

  <main>
    <Hero {...hero} />
    <AboutCavaliers about={about} features={features} />
    <Process {...process} />
    <Catalog figures={figures} />
    <Testimonials {...testimonials} />
    <Faq {...faq} />
    <Order figures={figures} legal={legal} />
  </main>

  <Footer brand={meta.brand} />
</Layout>

