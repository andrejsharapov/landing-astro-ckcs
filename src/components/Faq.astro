---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  pill: string;
  title: string;
  lead: string;
  items: FaqItem[];
}

const { pill, title, lead, items } = Astro.props;
---

<section id="faq" class="faq">
  <div class="container">
    <div class="section-head">
      <span class="pill">{pill}</span>
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>

    <div class="faq__list">
      {items.map((item, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-item__question">
            <span>{item.q}</span>
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
